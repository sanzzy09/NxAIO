
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment Sync Trigger: v5 - Refined profile and follow rules for project nex-aio.
    
    // Global stats are publicly readable
    match /system/stats {
      allow read: if true;
      allow write: if false;
    }

    // Profiles are publicly readable so users can find each other
    match /users/{userId} {
      allow read: if true;
      
      // Only the owner can update their own profile (create, update, delete)
      allow write: if request.auth != null && request.auth.uid == userId;

      // Follower management: anyone can read, only the follower can write their own record
      match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Following management: anyone can read, only the user can manage who they follow
      match /following/{followedId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
