
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment Sync Trigger: v18 - Re-syncing for explicit editor_history and app_builds authorization.
    
    // Global stats are publicly readable and writable for real-time tracking
    match /system/stats {
      allow read: if true;
      allow write: if true;
    }

    // Profiles rules
    match /users/{userId} {
      // Allow read if profile is not private OR requester is the owner
      allow read: if (resource == null || resource.data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
      
      // Only the owner can update their own profile (create, update, delete)
      allow write: if request.auth != null && request.auth.uid == userId;

      // Follower management
      match /followers/{followerId} {
        allow read: if (get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Following management
      match /following/{followedId} {
        allow read: if (get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Explicit subcollection access for authenticated owners
      match /activities/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
      match /uploads/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
      match /music/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
      match /removals/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
      match /editor_history/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
      match /mailboxes/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
      match /agent_messages/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
      match /app_builds/{id} { allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId; }
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
