
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment Sync Trigger: v9 - Allowed stats updates from client.
    
    // Global stats are publicly readable and writable for real-time tracking
    match /system/stats {
      allow read: if true;
      allow write: if true;
    }

    // Profiles rules
    match /users/{userId} {
      // Allow read if profile is not private OR requester is the owner
      allow read: if (resource == null || resource.data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
      
      // Only the owner can update their own profile (create, update, delete)
      allow write: if request.auth != null && request.auth.uid == userId;

      // Follower management
      match /followers/{followerId} {
        // Can read if profile is public OR requester is owner
        allow read: if (get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Following management
      match /following/{followedId} {
        allow read: if (get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Activity logs: only the owner can read and write their logs
      match /activities/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // File uploads: only the owner can read and write their upload history
      match /uploads/{uploadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
