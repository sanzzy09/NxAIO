rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global stats are publicly readable for the landing page hero section
    // Re-applying this rule to ensure it is correctly deployed to the backend.
    match /system/stats {
      allow read: if true;
      allow write: if false; // Stats should only be updated by server-side processes or admins
    }

    // User profiles are only accessible by the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}