
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment Sync Trigger: v16 - Explicitly authorizing list operations for subcollections.
    
    // Global stats are publicly readable and writable for real-time tracking
    match /system/stats {
      allow read: if true;
      allow write: if true;
    }

    // Profiles rules
    match /users/{userId} {
      // Allow read if profile is not private OR requester is the owner
      allow read: if (resource == null || resource.data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
      
      // Only the owner can update their own profile (create, update, delete)
      allow write: if request.auth != null && request.auth.uid == userId;

      // Follower management
      match /followers/{followerId} {
        allow read: if (get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Following management
      match /following/{followedId} {
        allow read: if (get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false) || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection access: restricted to the owner
      match /activities/{activityId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /uploads/{uploadId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /music/{musicId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /removals/{removalId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /editor_history/{historyId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /mailboxes/{mailboxId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /agent_messages/{messageId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /app_builds/{buildId} {
        allow get, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
