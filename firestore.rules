
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment Sync Trigger: v2 - Following system added.
    
    match /system/stats {
      allow read: if true;
      allow write: if false;
    }

    // Profiles are publicly readable so users can find each other
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Follower management
      match /followers/{followerId} {
        allow read: if true;
        // A user can only 'add themselves' to someone else's followers if they are the follower
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Following management
      match /following/{followedId} {
        allow read: if true;
        // A user can only manage their own 'following' list
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
