rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly allow public read access for global platform statistics
    // Used by the hero section on the landing page
    match /system/stats {
      allow read: if true;
      allow write: if false; // Only manageable via admin/server processes
    }

    // Individual user profiles - restricted to owners
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}