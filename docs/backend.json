
{
  "entities": {
    "GlobalStats": {
      "title": "GlobalStats",
      "description": "Aggregated statistics for the platform.",
      "type": "object",
      "properties": {
        "totalUsers": {
          "type": "number",
          "description": "The total number of registered users."
        },
        "totalVisitors": {
          "type": "number",
          "description": "The total number of unique visits."
        },
        "registrationsToday": {
          "type": "number",
          "description": "Number of users registered today."
        }
      },
      "required": ["totalUsers", "totalVisitors", "registrationsToday"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Information about a registered user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "description": "URL to profile image, supports GIF." },
        "bannerURL": { "type": "string", "description": "URL to profile background banner." },
        "frameId": { "type": "string", "description": "The ID of the selected avatar frame." },
        "isPrivate": { "type": "boolean", "default": false, "description": "Whether the profile is hidden from public view." },
        "role": { "type": "string", "enum": ["free", "pro", "sultan"], "default": "free" },
        "subscriptionEnd": { "type": "string", "format": "date-time", "description": "When the pro subscription expires." },
        "tempMailUsage": {
          "type": "object",
          "properties": {
            "count": { "type": "number", "default": 0 },
            "lastReset": { "type": "string", "format": "date" }
          }
        },
        "aiUsage": {
          "type": "object",
          "properties": {
            "tokens": { "type": "number", "default": 0 },
            "lastReset": { "type": "string", "format": "date" }
          }
        },
        "musicUsage": {
          "type": "object",
          "properties": {
            "count": { "type": "number", "default": 0 },
            "weekStart": { "type": "string", "format": "date-time" }
          }
        },
        "removerUsage": {
          "type": "object",
          "properties": {
            "count": { "type": "number", "default": 0 },
            "lastReset": { "type": "string", "format": "date" }
          }
        },
        "followersCount": { "type": "number", "default": 0 },
        "followingCount": { "type": "number", "default": 0 },
        "preferences": {
          "type": "object",
          "properties": {
            "productUpdates": { "type": "boolean", "default": true },
            "weeklyDigest": { "type": "boolean", "default": false },
            "timezone": { "type": "string", "default": "Asia/Jakarta" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "FollowRecord": {
      "title": "FollowRecord",
      "description": "A record indicating a follow relationship.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Record of a user action.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["login", "logout", "signup", "profile_update", "follow", "unfollow", "file_upload"] },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["type", "description", "timestamp"]
    },
    "FileUploadRecord": {
      "title": "FileUploadRecord",
      "description": "Record of a file bucket uploaded by the user.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "url": { "type": "string" },
        "expires": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "fileCount": { "type": "number" },
        "totalSize": { "type": "number" },
        "status": { "type": "string", "default": "active" }
      },
      "required": ["slug", "url", "timestamp"]
    },
    "MusicRecord": {
      "title": "MusicRecord",
      "description": "Record of an AI generated music track.",
      "type": "object",
      "properties": {
        "songId": { "type": "string" },
        "title": { "type": "string" },
        "audio": { "type": "string" },
        "image": { "type": "string" },
        "duration": { "type": "number" },
        "tags": { "type": "string" },
        "lyrics": { "type": "string" },
        "prompt": { "type": "string" },
        "mode": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["songId", "title", "audio", "timestamp"]
    },
    "RemovalRecord": {
      "title": "RemovalRecord",
      "description": "Record of a background removal task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "resultUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "resultUrl", "timestamp"]
    },
    "EditorHistoryRecord": {
      "title": "EditorHistoryRecord",
      "description": "Record of an AI image editing task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "resultUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "prompt", "resultUrl", "timestamp"]
    },
    "MailboxRecord": {
      "title": "MailboxRecord",
      "description": "Record of a temporary mailbox session.",
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "token": { "type": "string" },
        "cookies": { "type": "object" },
        "isActive": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["address", "token", "timestamp"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message in an AI conversation history.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "toolCalls": { "type": "array" },
        "usage": { "type": "object" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "AppBuildRecord": {
      "title": "AppBuildRecord",
      "description": "Record of an Android app build process.",
      "type": "object",
      "properties": {
        "appId": { "type": "string" },
        "appName": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "result": { "type": "object" }
      },
      "required": ["appId", "appName", "url", "status", "timestamp"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/system/stats": {
      "schema": "GlobalStats",
      "description": "Real-time platform statistics."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profile data."
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": "FollowRecord",
      "description": "Record of who follows this user."
    },
    "/users/{userId}/following/{followedId}": {
      "schema": "FollowRecord",
      "description": "Record of who this user follows."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "ActivityLog",
      "description": "User specific activity logs."
    },
    "/users/{userId}/uploads/{uploadId}": {
      "schema": "FileUploadRecord",
      "description": "History of user file uploads."
    },
    "/users/{userId}/music/{musicId}": {
      "schema": "MusicRecord",
      "description": "User's generated music history."
    },
    "/users/{userId}/removals/{removalId}": {
      "schema": "RemovalRecord",
      "description": "User's background removal history."
    },
    "/users/{userId}/editor_history/{historyId}": {
      "schema": "EditorHistoryRecord",
      "description": "User's AI image editing history."
    },
    "/users/{userId}/mailboxes/{mailboxId}": {
      "schema": "MailboxRecord",
      "description": "User's temporary mailbox history."
    },
    "/users/{userId}/agent_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Persistent AI conversation history for continuity."
    },
    "/users/{userId}/app_builds/{buildId}": {
      "schema": "AppBuildRecord",
      "description": "User's Android app build history."
    }
  }
}
